# shellcheck shell=sh
# ~/.shellrc: interactive settings shared by bash and zsh.
# Sourced from ~/.bashrc and ~/.zshrc -- keep it POSIX sh compatible.

# Environment
export EDITOR='nano'
export LESS=-FRX

# Aliases
alias dir='ls -ahl --group-directories-first'
alias cd..='cd ..'

# ssh-agent: use a single agent per user instead of one per shell, in order:
# 1. a forwarded agent (SSH_AUTH_SOCK already set) is left alone
# 2. on WSL, the Windows ssh-agent via wsl2-ssh-agent (installed by setup.sh)
# 3. the systemd user agent (ssh-agent.socket)
# 4. an agent on a fixed socket that all shells share
# Keys are added on first use via AddKeysToAgent in ~/.ssh/config.
if [ -z "$SSH_AUTH_SOCK" ] && [ -n "$WSL_DISTRO_NAME" ] && [ -x "$HOME/.local/bin/wsl2-ssh-agent" ]; then
  eval "$("$HOME/.local/bin/wsl2-ssh-agent")"
fi
if [ -z "$SSH_AUTH_SOCK" ]; then
  if [ -S "${XDG_RUNTIME_DIR:-/nonexistent}/openssh_agent" ]; then
    export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/openssh_agent"
  else
    export SSH_AUTH_SOCK="$HOME/.ssh/agent.sock"
    ssh-add -l >/dev/null 2>&1
    if [ $? -eq 2 ]; then # 2 = no agent listening
      mkdir -p -m 700 "$HOME/.ssh"
      rm -f "$SSH_AUTH_SOCK"
      ssh-agent -a "$SSH_AUTH_SOCK" >/dev/null
    fi
  fi
fi

# WSL: keep ~/.ssh/config.d/windows.conf, a copy of the Windows ssh config
# converted for Linux ssh, up to date. ~/.ssh/windows links to the Windows .ssh
# folder and ~/.ssh/config includes the copy; both are set up by setup.sh.
# The Windows file can't be included directly: on /mnt/c it is world-writable,
# which ssh refuses. Key paths are pointed at the Windows .ssh folder so ssh
# finds the .pub files matching the keys in the Windows agent.
if [ -d ~/.ssh/windows ]; then
  _win=~/.ssh/windows/config
  _gen=~/.ssh/config.d/windows.conf
  if [ ! -f "$_gen" ] || { [ -f "$_win" ] && [ "$_win" -nt "$_gen" ]; }; then
    mkdir -p ~/.ssh/config.d
    (
      umask 077
      {
        echo "# GENERATED from ~/.ssh/windows/config by ~/.shellrc -- do not edit"
        echo "UserKnownHostsFile ~/.ssh/known_hosts ~/.ssh/windows/known_hosts"
        if [ -f "$_win" ]; then
          tr -d '\r' < "$_win" | sed -e '/^[[:space:]]*\(IdentityFile\|CertificateFile\)/I{
            s#\\#/#g
            s#\(~\|%d\)/\.ssh/#~/.ssh/windows/#
          }' -e '$a\'
        fi
      } > "$_gen.tmp" && mv "$_gen.tmp" "$_gen"
    )
  fi
  unset _win _gen
fi

# Machine-specific settings that should not be committed
if [ -f ~/.local_env ]; then
  . ~/.local_env
fi
